.venv/
venv/
__pycache__/
*.pyc
.pytest_cache/
.cache/*.json
.cache/web_tiles/
.cache/web_profile/
data/*.xlsx
data/Full Page Screenshots/
metadata.json

# Run snapshots: large captured artifacts (raw SERP HTML, screenshots, xlsx). The manifests
# and index are cheap and worth keeping, so the run tree itself is ignored selectively.
runs/*/serp/html/
runs/*/serp/screenshots/
runs/*/.cache/
runs/*/data/
# Browser profile — session cookies and solved-CAPTCHA state. Never commit.
.browser/
web/dist/
.superpowers/

# Secrets — never commit. See .env.example for the required keys.
.env
.env.local
.claude/settings.local.json

# v3 verification output. The contact sheet embeds every screenshot as base64
# and lands at ~13 MB, so it is regenerated on demand rather than committed:
#   python docs/redesign/v3/tools/contact_sheet.py
docs/redesign/v3/verification/*.png
docs/redesign/v3/verification/contact-sheet.html
docs/redesign/v3/verification/before/
docs/redesign/v3/verification/after/
.superpowers/

# vendor build scratch (echarts tree-shake)
web/.echarts-build/
.playwright-mcp/

# Installed skill/tooling source cached into the project — not project code.
.claude/.skill-sources/
.claude/skills/
.claude/scheduled_tasks.lock

# codebase-memory index artifact — derived data, ~3 MB binary that fully rewrites on
# every re-index. Regenerate with index_repository rather than versioning the churn.
.codebase-memory/
